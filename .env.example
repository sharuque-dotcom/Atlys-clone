# Database — SQLite for local dev. For production use PostgreSQL hosted in a UAE region
# (e.g. AWS me-central-1 / Azure UAE North) and switch the provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# 32+ random bytes, used to sign session cookies
SESSION_SECRET="change-me-to-a-long-random-string"

# Public base URL (used in emails / WhatsApp links)
APP_URL="http://localhost:3000"

# Document storage directory (local dev). In prod, point the storage adapter at a UAE-region bucket.
STORAGE_DIR="./storage"

# WhatsApp Business Cloud API (optional — notifications are logged to the console when unset)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# UAE PASS OpenID Connect (optional — button is hidden when unset)
UAEPASS_CLIENT_ID=""
UAEPASS_CLIENT_SECRET=""
UAEPASS_ISSUER="https://stg-id.uaepass.ae"

# Concierge WhatsApp number shown in the app (digits only, e.g. 9714XXXXXXX)
SUPPORT_WHATSAPP=""

# Safar's own UAE VAT TRN printed on tax invoices
SAFAR_TRN=""

# AI document review (Claude). Without a key, uploads are stored but not AI-checked.
ANTHROPIC_API_KEY=""
# Optional override of the review model
SAFAR_AI_MODEL="claude-opus-5-5"

# Headless Chromium used to render letters into the print pack (auto-detected if unset)
CHROMIUM_PATH=""
