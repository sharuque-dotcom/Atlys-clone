// Safar — data model (tenants are travel agencies serving retail customers)
// Enum-like fields are stored as strings (see src/lib/types.ts for the allowed values)
// so the same schema runs on SQLite (dev) and PostgreSQL (production, UAE region).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Enterprise {
  id               String   @id @default(cuid())
  name             String
  legalName        String
  domain           String?  @unique
  companyCode      String   @unique
  tradeLicenseNo   String?
  licenseAuthority String? // DED Dubai, ADDED, DMCC, JAFZA, ...
  trn              String? // UAE VAT Tax Registration Number (15 digits)
  invoiceType      String   @default("VAT") // VAT | NON_VAT
  emirate          String   @default("DXB")
  industry         String?
  size             String?
  creditLimitFils  Int      @default(0)
  plan             String   @default("GROWTH") // STARTER | GROWTH | ENTERPRISE
  // Travel-agency profile (each tenant is an agency reselling Safar visa processing to retail customers)
  tourismLicenseNo String? // DET / DCT travel agency licence
  phone            String?
  email            String?
  brandColor       String   @default("#0f7a69")
  markupPct        Int      @default(40) // default markup on Safar's net service fee
  invoicePrefix    String   @default("INV")
  createdAt        DateTime @default(now())

  branches       Branch[]
  users          User[]
  travelers      Traveler[]
  applications   Application[]
  accessRequests AccessRequest[]
  invoices       Invoice[]
  auditLogs      AuditLog[]
  messages       Message[]
  apiKeys        ApiKey[]
  webhooks       Webhook[]
  customers      Customer[]
  bookings       Booking[]
  agencyPrices   AgencyPrice[]
  payments       Payment[]
}

/// Agency's own retail service fee for a product (overrides markupPct)
model AgencyPrice {
  id            String     @id @default(cuid())
  enterpriseId  String
  enterprise    Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  productId     String
  serviceFeeFils Int

  @@unique([enterpriseId, productId])
}

/// A retail client of the agency — usually the head of a household who brings family members.
model Customer {
  id           String     @id @default(cuid())
  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  name         String
  phone        String? // WhatsApp
  email        String?
  emirate      String?
  source       String     @default("WALK_IN") // WALK_IN | WHATSAPP | REFERRAL | SOCIAL | WEBSITE | REPEAT
  notes        String?
  assignedToId String?
  assignedTo   User?      @relation("AssignedCustomers", fields: [assignedToId], references: [id])
  createdAt    DateTime   @default(now())

  members  Traveler[]
  bookings Booking[]

  @@index([enterpriseId, name])
}

/// One sale: a household's trip (one or more applications), with a quote, payments and a customer-facing portal link.
model Booking {
  id           String     @id @default(cuid())
  ref          String     @unique
  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  destination  String
  purpose      String
  travelStart  DateTime
  travelEnd    DateTime
  status       String     @default("QUOTED") // QUOTED | CONFIRMED | IN_PROGRESS | COMPLETED | CANCELLED
  portalToken  String     @unique
  sellTotalFils Int       @default(0)
  netTotalFils  Int       @default(0)
  discountFils  Int       @default(0)
  notes        String?
  createdById  String
  createdBy    User       @relation("BookingsCreated", fields: [createdById], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  applications Application[]
  payments     Payment[]
}

model Payment {
  id           String     @id @default(cuid())
  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  bookingId    String
  booking      Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amountFils   Int
  method       String // CASH | CARD | BANK_TRANSFER | PAYMENT_LINK
  reference    String?
  receivedBy   String
  createdAt    DateTime   @default(now())
}

model Branch {
  id           String     @id @default(cuid())
  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  name         String
  type         String     @default("BRANCH_OFFICE") // BILLING | SHIPPING | BRANCH_OFFICE
  emirate      String
  address      String
  travelers    Traveler[]
}



model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String?
  phone        String?
  role         String     @default("AGENT") // OWNER | ADMIN | AGENT | ACCOUNTANT
  locale       String     @default("en")
  enterpriseId String?
  enterprise   Enterprise? @relation(fields: [enterpriseId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  sessions        Session[]
  accessRequests  AccessRequest[]
  traveler        Traveler?       @relation("TravelerUser")
  createdApps     Application[]   @relation("CreatedBy")
  managedTravelers Traveler[]     @relation("Manager")
  customers        Customer[]     @relation("AssignedCustomers")
  bookings         Booking[]      @relation("BookingsCreated")
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AccessRequest {
  id           String     @id @default(cuid())
  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  designation  String?
  status       String     @default("PENDING") // PENDING | APPROVED | DENIED
  decidedById  String?
  createdAt    DateTime   @default(now())
  decidedAt    DateTime?
}

model Traveler {
  id                  String     @id @default(cuid())
  enterpriseId        String
  enterprise          Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  userId              String?    @unique
  user                User?      @relation("TravelerUser", fields: [userId], references: [id])
  managerId           String?
  manager             User?      @relation("Manager", fields: [managerId], references: [id])
  branchId            String?
  branch              Branch?    @relation(fields: [branchId], references: [id])
  customerId          String?
  customer            Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  relationship        String     @default("SELF") // SELF | SPOUSE | CHILD | PARENT | SIBLING | OTHER (relative to the customer)
  employmentType      String     @default("EMPLOYED") // EMPLOYED | SELF_EMPLOYED | DEPENDENT | STUDENT | RETIRED | UNEMPLOYED
  employerName        String?
  sponsorId           String? // family member whose income/residence sponsors this traveler
  employeeId          String?
  firstName           String
  lastName            String
  email               String?
  phone               String?
  gender              String?
  dateOfBirth         DateTime?
  nationality         String // ISO 3166-1 alpha-2
  designation         String?
  department          String?
  monthlySalaryAed    Int?
  joinedAt            DateTime?
  passportNo          String?
  passportIssuedAt    DateTime?
  passportExpiry      DateTime?
  uaeResident         Boolean    @default(true)
  emiratesIdNo        String?
  emiratesIdExpiry    DateTime?
  residenceVisaExpiry DateTime?
  priorRejections     Int        @default(0)
  travelHistory       String     @default("") // comma separated ISO2 visited in last 5y
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  documents    TravelerDocument[]
  applications Application[]
}

model TravelerDocument {
  id         String    @id @default(cuid())
  travelerId String
  traveler   Traveler  @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  type       String // see DOCUMENT_TYPES
  fileName   String
  mimeType   String
  size       Int
  storageKey String
  sha256     String
  expiresAt  DateTime?
  extracted  String? // JSON — fields extracted by OCR / MRZ
  createdAt  DateTime  @default(now())
}


model Application {
  id                String       @id @default(cuid())
  ref               String       @unique
  enterpriseId      String
  enterprise        Enterprise   @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  travelerId        String
  traveler          Traveler     @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  bookingId         String?
  booking           Booking?     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  destination       String
  productId         String
  purpose           String
  travelStart       DateTime
  travelEnd         DateTime
  bundle            String       @default("STANDARD") // STANDARD | PRIORITY | PROTECT
  status            String       @default("DRAFT")
  riskScore         Int?
  riskReport        String? // JSON
  pricing           String // JSON PriceBreakdown (fils) — retail price charged to the customer
  netPricing        String? // JSON PriceBreakdown (fils) — Safar's wholesale price to the agency
  appointmentAt     DateTime?
  appointmentCenter String?
  courier           String? // PICKUP | DROP_OFF | NONE
  courierAddress    String?
  notes             String?
  createdById       String
  createdBy         User         @relation("CreatedBy", fields: [createdById], references: [id])
  submittedAt       DateTime?
  decidedAt         DateTime?
  invoiceId         String?
  invoice           Invoice?     @relation(fields: [invoiceId], references: [id])
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  events   ApplicationEvent[]
  messages Message[]
}

model ApplicationEvent {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String
  message       String
  actorName     String?
  createdAt     DateTime    @default(now())
}

model Invoice {
  id           String        @id @default(cuid())
  number       String        @unique
  enterpriseId String
  enterprise   Enterprise    @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  periodStart  DateTime
  periodEnd    DateTime
  issuedAt     DateTime      @default(now())
  dueAt        DateTime
  taxableFils  Int
  vatFils      Int
  disbursementFils Int // government fees passed through at cost (outside the scope of VAT)
  totalFils    Int
  status       String        @default("ISSUED") // DRAFT | ISSUED | PAID | OVERDUE
  paidAt       DateTime?
  applications Application[]
}

model Message {
  id            String       @id @default(cuid())
  enterpriseId  String
  enterprise    Enterprise   @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorName    String
  fromAgent     Boolean      @default(false)
  body          String
  createdAt     DateTime     @default(now())
}

model AuditLog {
  id           String     @id @default(cuid())
  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  actorId      String?
  actorName    String
  action       String
  entity       String
  entityId     String?
  meta         String?
  createdAt    DateTime   @default(now())

  @@index([enterpriseId, createdAt])
}

model ApiKey {
  id           String     @id @default(cuid())
  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  name         String
  prefix       String
  hash         String     @unique
  lastUsedAt   DateTime?
  createdAt    DateTime   @default(now())
  revokedAt    DateTime?
}

model Webhook {
  id           String     @id @default(cuid())
  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  url          String
  secret       String
  events       String // comma separated
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
}
